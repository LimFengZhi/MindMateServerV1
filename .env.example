# ===========================================================================
# MindMate environment template.
# Copy to `.env` and fill in your values:   cp .env.example .env
# NEVER commit the real .env — it holds the Supabase SECRET key (bypasses RLS).
# ===========================================================================

# --- Supabase (required) ---------------------------------------------------
# Project URL + keys: Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-service-role-secret-key
# Optional publishable/anon key, used for the user auth flow (least privilege).
# Falls back to the secret key if left blank.
SUPABASE_ANON_KEY=

# Where Supabase email links (verification) send users back to.
SITE_URL=http://localhost:5000

# --- Flask -------------------------------------------------------------------
# Blank = a random key is generated each start (sessions reset on restart).
# Set a long fixed value for anything beyond local dev.
SECRET_KEY=
# 1 enables the Werkzeug debugger — DEV ONLY (remote-code-execution risk).
FLASK_DEBUG=0
# 0.0.0.0 exposes the app on your LAN (needed for testing from a phone).
FLASK_HOST=127.0.0.1

# --- AI pipeline -------------------------------------------------------------
# "stub" = instant rule-based agents (no downloads). "real" = load local models
# from the paths below (each falls back to its stub if loading fails).
AI_MODE=stub

# Only used when AI_MODE=real. Paths resolve relative to the project root.
CHAT_MODEL_PATH=models/chat_models/merged/gemma2
CLASSIFIER_PATH=models/classifier_models/roberta
SUMMARIZER_PATH=Qwen/Qwen2.5-0.5B-Instruct

# Devices: "auto" | "cuda" | "cpu".  Dtype: "auto" | "bf16" | "fp16" | "fp32".
CHATBOT_DEVICE=auto
CHATBOT_DTYPE=auto
SUMMARIZER_DEVICE=cpu

# Extra comparison models for the staff Test Chat bench (lazy-loaded on
# first '3 Models' run; defaults point at the study's merged weights).
#BENCH_LLAMA32_PATH=models/chat_models/mentalchat16k/llama32_merged
#BENCH_QWEN3_PATH=models/chat_models/mentalchat16k/qwen3_merged

# NOTE: non-secret app tuning (generation temperature/max tokens, memory
# window, risk thresholds, crisis message) lives in config.yaml, not here.
# .env is only for secrets and machine-specific values.

# --- Crisis email (SMTP credentials only) ------------------------------------
# Used when config.yaml's crisis_email.enabled is true: the counselling
# information is emailed to the user whenever a chat turn escalates to a
# crisis (cooldown and wording also live in that config.yaml block).
# Gmail: smtp.gmail.com + port 587 + an App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
# Sender address shown to the user; defaults to SMTP_USER if blank.
MAIL_FROM=

# --- Voice (faster-whisper, works in either AI_MODE) -------------------------
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
